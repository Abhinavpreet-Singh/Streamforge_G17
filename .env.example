# StreamForge local environment (copy to .env and adjust)
# cp .env.example .env   — Linux/Mac
# copy .env.example .env — Windows

# Demo-friendly defaults: 30s windows, 100 trucks, 2s producer interval
DEMO_MODE=1

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER=localhost:9092

# Faust consumer group / app id (change for isolated replays)
APP_ID=streamforge

# Window tuning (seconds) — ignored when DEMO_MODE=1 unless you override
WINDOW_SIZE_SECONDS=300
HOPPING_STEP_SECONDS=60
WINDOW_EXPIRES_SECONDS=600
TOPIC_PARTITIONS=20

# Producer
TRUCK_COUNT=100
PRODUCE_INTERVAL_SECONDS=2

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# API (uvicorn)
# Bind: uvicorn src.api.main:app --reload --port 8000
